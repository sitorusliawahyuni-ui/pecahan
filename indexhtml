    <style>
        /* Pengaturan Font Utama Ramah Anak */
        body {
            font-family: 'Nunito', sans-serif;
            background-color: #F0F9FF;
            background-image: radial-gradient(#BAE6FD 2px, transparent 2px);
            background-size: 28px 28px;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        h1, h2, .font-display {
            font-family: 'Fredoka', cursive, sans-serif;
        }

        /* Animasi Getar Kartu Saat Bunyi Aktif */
        @keyframes cardVibrateShort {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            20% { transform: translate(-4px, 2px) rotate(-2deg); }
            40% { transform: translate(4px, -2px) rotate(2deg); }
            60% { transform: translate(-4px, -2px) rotate(-1deg); }
            80% { transform: translate(4px, 2px) rotate(1deg); }
        }

        @keyframes cardVibrateLong {
            0%, 100% { transform: scale(1); }
            25% { transform: scale(1.04) translateY(-3px); }
            50% { transform: scale(1.02) translateY(2px); }
            75% { transform: scale(1.05) translateY(-2px); }
        }

        @keyframes cardRoar {
            0%, 100% { transform: scale(1) rotate(0deg); }
            15% { transform: scale(1.08) rotate(-3deg); }
            30% { transform: scale(1.08) rotate(3deg); }
            45% { transform: scale(1.06) rotate(-3deg); }
            60% { transform: scale(1.06) rotate(3deg); }
            75% { transform: scale(1.04) rotate(-1deg); }
        }

        .anim-short {
            animation: cardVibrateShort 0.35s ease-in-out infinite;
        }

        .anim-long {
            animation: cardVibrateLong 0.8s ease-in-out infinite;
        }

        .anim-roar {
            animation: cardRoar 0.5s ease-in-out infinite;
        }

        /* Animasi Balon Komik Onomatope */
        @keyframes comicPop {
            0% { transform: scale(0.8); opacity: 0.7; }
            50% { transform: scale(1.12); opacity: 1; }
            100% { transform: scale(1); opacity: 1; }
        }

        .comic-pop {
            animation: comicPop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        /* Animasi Riak Getaran Visual (Ripple) */
        @keyframes pulseRing {
            0% { transform: scale(0.85); opacity: 0.8; }
            100% { transform: scale(1.55); opacity: 0; }
        }

        .vibration-ring {
            animation: pulseRing 1s cubic-bezier(0.24, 0, 0.38, 1) infinite;
        }

        /* Gaya Balon Komik */
        .speech-bubble {
            position: relative;
            background: #FFFFFF;
            border: 4px solid #1E293B;
            box-shadow: 0 6px 0 #1E293B;
        }

        .speech-bubble::after {
            content: '';
            position: absolute;
            bottom: -16px;
            left: 50%;
            transform: translateX(-50%);
            border-width: 16px 14px 0;
            border-style: solid;
            border-color: #1E293B transparent transparent transparent;
        }

        .speech-bubble::before {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            border-width: 12px 10px 0;
            border-style: solid;
            border-color: #FFFFFF transparent transparent transparent;
            z-index: 1;
        }

        /* Animasi Bintang Kuis */
        @keyframes starBounce {
            0%, 100% { transform: scale(1) rotate(0deg); }
            50% { transform: scale(1.35) rotate(15deg); }
        }
        .star-win {
            animation: starBounce 0.6s ease-in-out;
        }
    </style>
</head>
